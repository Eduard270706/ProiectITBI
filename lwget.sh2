#!/bin/bash

if [ "$1" = "cleanup" ]; then
   echo "Cleanup: se sterg toate datele..."
   rm -rf date
   echo "Cleanup: Stergere completa!"
   exit 0
fi

URL="$1"
NIVEL=1

[ -z "$URL" ] && 
   {
   echo "Sintaxa invalida!"
   echo "Apeleaza: $0 <URL> | $0 cleanup"; 
   exit 1; 
   }
  
case "$URL" in 
   http://*|https://*) : ;;
   *) URL="https://$URL" ;;
esac 

mkdir -p date/nivel0
cd date/nivel0

LINKS="../links$NIVEL.txt"
START="../start_url.txt"
DOMENIU="$URL"
DIR="$URL/"
START_URL=""

if ! wget -O index.html "$URL"; then
   echo "URL invalid sau inaccesibil"
   exit 1
fi

if [ ! -f "$START" ]; then
   echo "$URL" > "$START"
fi

[ -f "$START" ] && START_URL="$(cat "$START")"

if [ "$URL" != "$START_URL" ] && [ -n "$START_URL" ] ; then
   echo "Error: Proiectul este pentru $START_URL."
   echo "Tu ai apelat pentru $URL."
   echo "Apeleaza $0 cleanup pentru a incepe alt site."
   exit 1
   else
   
fi

grep 'href="' index.html | cut -d'"' -f2 \
| grep -v '^#' \
| grep -v '^javascript:' \
| grep -v '^mailto:' \
| grep -v '^tel:' \
| grep -v '\.css$' \
| grep -v '\.js$' \
| grep -E '/|^https?://' \
| sort -u \
> "$LINKS"

TEMP=$(mktemp)

while IFS= read -r link; do
   link="${link%%#*}"
   [[ -z "$link" ]] && continue
   if [[ "$link" == http://* || "$link" == https://* ]]; then
      echo "$link"
   elif [[ "$link" == /* ]]; then
      echo "$DOMENIU$link"
   else
      echo "$DIR$link"
   fi  
done < "$LINKS" | sort -u > "$TEMP"
mv "$TEMP" "$LINKS"

